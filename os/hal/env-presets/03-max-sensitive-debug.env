# Voice VAD preset 03: maximum sensitivity for debugging.
# This can trigger on noise. Use briefly to prove whether WebRTC/Silero are
# rejecting quiet first syllables, then go back to preset 01 or 02.

HAL_VAD_THRESHOLD=500
HAL_SPEECH_HOLDOFF=0.05
HAL_PRE_ROLL_FRAMES=12
HAL_SILENCE_TIMEOUT=3.0

# Disable secondary filters for maximum entry sensitivity.
HAL_WEBRTCVAD_ENABLED=false
HAL_SILERO_ENABLED=false

# Lower first-turn latency, but can increase idle STT cost.
HAL_STT_KEEPALIVE=true

HAL_WARM_MIC=true
HAL_WARM_MIC_ECHO_SKIP_MAX_S=0.1
HAL_ECHO_RMS_FLOOR=300

# Keep Gemini protected from empty-STT noise turns.
HAL_REALTIME_REQUIRE_TRANSCRIPT=true
HAL_REALTIME_REQUIRE_SPEECH_ON_EMPTY_STT=true
HAL_REALTIME_NOISE_SPEECH_RATIO=0.55
HAL_REALTIME_TURN_DETECTION=off
